# Copy to .env to override defaults. No secrets are required: all models run locally in Ollama.
OLLAMA_URL=http://localhost:11434
TEXT_MODEL=qwen2.5:3b
VISION_MODEL=gemma3:4b
EMBEDDING_MODEL=nomic-embed-text
# llm = LLM coordinator chooses each tool; rules = deterministic planner (faster, no LLM decisions)
COORDINATOR_MODE=llm
MAX_REACT_STEPS=12
TOP_K=5
MIN_SIMILARITY=0.63
LLM_TIMEOUT_S=180
VISION_TIMEOUT_S=600
# Set to 0 to run the vision model on CPU (recommended if the GPU has < 4 GB free)
VISION_NUM_GPU=
